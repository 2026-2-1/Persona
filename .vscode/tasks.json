      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Persona: DB·Redis 종료",
      "type": "process",
      "command": "bash",
      "args": ["scripts/stop.sh"],
