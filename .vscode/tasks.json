      "args": ["scripts/setup.sh"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Persona: 개발 실행",
      "type": "process",
      "command": "bash",
      "args": ["scripts/dev.sh"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Persona: 검사",
      "type": "process",
      "command": "bash",
