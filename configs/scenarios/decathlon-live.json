{
  "study_id": "decathlon-live-search-price-detail",
  "task": "공개 데카트론에서 러닝화 검색 후 8만원 이하 가격 필터를 적용하고 킵코어 상세의 이름과 가격만 확인한다.",
  "start_url": "https://www.decathlon.co.kr/",
  "allowed_origins": [
    "https://www.decathlon.co.kr",
    "https://decathlon.co.kr"
  ],
  "profile_file": "../decathlon_live_profile.json",
  "run_timeout_seconds": 300,
  "action_timeout_ms": 15000,
  "steps": [
    {
      "label": "프로모션 닫기(있는 경우)",
      "type": "click",
      "target_name": "Close",
      "optional": true
    },
    {
      "label": "프로모션 텍스트 닫기(있는 경우)",
      "type": "click",
      "target_name": "창 닫기",
      "optional": true
    },
    {
      "label": "알림 안내 닫기(있는 경우)",
      "type": "click",
      "target_name": "다음에",
      "optional": true
    },
    {
      "label": "러닝화 검색어 입력",
      "type": "type",
      "target_selector": "[data-cy=\"search-bar-desktop\"] input",
      "text": "러닝화",
      "input_mode": "sequential"
    },
    {
      "label": "한글 입력 이벤트와 검색 제안 준비",
      "type": "keypress",
      "target_selector": "[data-cy=\"search-bar-desktop\"] input",
      "key": "Space",
      "settle_for_ms": 800
    },
    {
      "label": "한글 검색어 확정",
      "type": "keypress",
      "target_selector": "[data-cy=\"search-bar-desktop\"] input",
      "key": "Enter",
      "settle_for_ms": 500
    },
    {
      "label": "Enter 검색과 입력/URL/상품명 확인",
      "type": "keypress",
      "target_selector": "[data-cy=\"search-bar-desktop\"] input",
      "key": "Enter",
      "check": "search",
      "expectations": {
        "query": "러닝화"
      },
      "checkpoint_timeout_ms": 10000
    },
    {
      "label": "가격 메뉴 열기",
      "type": "click",
      "target_name": "가격",
      "target_role": "button"
    },
    {
      "label": "가격 입력 영역까지 스크롤",
      "type": "scroll",
      "scroll_y": 600
    },
    {
      "label": "최대 가격 입력",
      "type": "type",
      "target_selector": "input[data-testid=\"price-filter-input\"]",
      "target_index": 1,
      "text": "80000"
    },
    {
      "label": "가격 변경 적용과 상품 가격 확인",
      "type": "keypress",
      "target_selector": "input[data-testid=\"price-filter-input\"]",
      "target_index": 1,
      "key": "Tab",
      "check": "filters_price",
      "expectations": {
        "query": "러닝화",
        "max_price": 80000
      },
      "checkpoint_timeout_ms": 10000
    },
    {
      "label": "필터 결과 상품으로 복귀",
      "type": "scroll",
      "scroll_y": -600
    },
    {
      "label": "관찰된 킵코어 상품 상세 진입",
      "type": "click",
      "target_selector": "a[data-cy=\"productTile\"][href*=\"-8926930.html\"]",
      "check": "detail_basic",
      "expectations": {
        "product_name": "남성 러닝화 킵코어",
        "max_price": 80000
      },
      "checkpoint_timeout_ms": 10000
    }
  ],
  "warmup_ms": 1500
}
